generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UnitOfMeasure {
  UN
  M2
  M
  CM
  MM
  KG
  G
  L
  ML
  ROLO
  CHAPA
  CAIXA
  PACOTE
  KIT
}

enum ComponentType {
  MATERIAL
  SERVICE
  LABOR
  EQUIPMENT
  OUTSOURCED
  TRANSPORT
  TAX
  FINISHING
  CUSTOM
}

enum TeamRole {
  LEADER
  INSTALLER
  ASSISTANT
  WELDER
  PAINTER
  DESIGNER
  PRINTER_OPERATOR
  FINISHING
  CUSTOM
}

enum EquipmentCostType {
  HOUR
  DAY
  KM
  UNIT
  MONTH
}

enum QuotationStatus {
  DRAFT
  PENDING
  SENT
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  VALUE
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  TEAM_MEMBER
  VIEWER
}

enum ProjectStatus {
  WAITING
  PLANNING
  IN_PRODUCTION
  WAITING_INSTALLATION
  INSTALLING
  FINISHED
  DELIVERED
  CANCELLED
}

enum TaskStatus {
  PENDING
  WAITING
  IN_PROGRESS
  PAUSED
  FINISHED
  CANCELLED
}

model Company {
  id        String    @id @default(uuid())
  isActive  Boolean   @default(true)

  // Dados Gerais
  razaoSocial       String
  nomeFantasia      String
  cnpj              String   @unique
  inscricaoEstadual String?
  inscricaoMunicipal String?

  // Contatos
  telefone  String?
  celular   String?
  email     String?
  site      String?
  whatsapp  String?

  // Endereço
  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?
  pais        String   @default("Brasil")

  // Identidade Visual
  logoUrl      String?
  faviconUrl   String?
  corPrimaria  String   @default("#3b82f6")
  corSecundaria String  @default("#1e40af")

  // Dados Bancários
  banco     String?
  agencia   String?
  conta     String?
  pix       String?
  favorecido String?

  // Funcionamento
  horarioInicio  String   @default("08:00")
  horarioFim     String   @default("18:00")
  trabalhaSabado Boolean  @default(true)
  trabalhaDomingo Boolean @default(false)

  // Configurações
  moeda       String   @default("BRL")
  idioma      String   @default("pt-BR")
  timezone    String   @default("America/Sao_Paulo")
  formatoData String   @default("DD/MM/YYYY")

  // Multi-Tenant
  status     String   @default("active")
  planId     String?
  plan       Plan?    @relation(fields: [planId], references: [id])
  settings   Json?
  subscription Subscription?

  // Auditoria
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  users              User[]
  companySettings    CompanySettings[]
  clients            Client[]
  projects           Project[]
  departments        Department[]
  templates          Template[]
  serviceCategories     ServiceCategory[]
  serviceSubcategories  ServiceSubcategory[]
  services              CatalogService[]
  materialCategories    MaterialCategory[]
  materials             Material[]
  teams                 Team[]
  teamMembers           TeamMember[]
  equipmentCategories   EquipmentCategory[]
  equipments            Equipment[]
  quotations            Quotation[]
  productionOrders      ProductionOrder[]
  teamProductivities    TeamProductivity[]
  workflows             Workflow[]
  aiProviders           AiProvider[]
  aiPrompts             AiPrompt[]
  aiConversations       AiConversation[]
  knowledgeCollections  KnowledgeCollection[]
  plugins               Plugin[]

  @@map("companies")
}

model Client {
  id        String    @id @default(uuid())
  name      String
  document  String?
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  zipCode   String?
  notes     String?
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  @@index([companyId])
  @@index([deletedAt])
  @@index([companyId, deletedAt])
  @@index([name])
  @@map("clients")
}

model User {
  id             String    @id @default(uuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])

  nome           String
  sobrenome      String
  email          String    @unique
  telefone       String?
  cargo          String?

  role           UserRole  @default(TEAM_MEMBER)
  roleId         String?
  status         String    @default("active")
  ultimoLogin    DateTime?
  emailVerificado Boolean  @default(false)

  avatarUrl      String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?
  deletedBy      String?

  @@index([companyId])
  @@index([deletedAt])
  @@index([companyId, deletedAt])
  @@index([email])
  @@index([role])
  @@map("users")
}

model Department {
  id          String   @id @default(uuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  name        String
  description String?
  color       String   @default("#3b82f6")
  icon        String   @default("Building2")
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)

  projectTasks     ProjectTask[]
  productionOrders ProductionOrder[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  @@index([companyId])
  @@index([deletedAt])
  @@index([companyId, deletedAt])
  @@map("departments")
}

model Project {
  id                String        @id @default(uuid())
  companyId         String
  company           Company       @relation(fields: [companyId], references: [id])
  quotationId       String?
  clientId          String?
  number            String        @unique
  name              String
  description       String?
  status            ProjectStatus @default(WAITING)
  priority          String        @default("normal")
  expectedStartDate DateTime?
  expectedEndDate   DateTime?
  actualStartDate   DateTime?
  actualEndDate     DateTime?
  notes             String?

  tasks            ProjectTask[]
  productionOrders ProductionOrder[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  @@index([companyId])
  @@index([deletedAt])
  @@index([companyId, deletedAt])
  @@index([clientId])
  @@index([status])
  @@map("projects")
}

model ProjectTask {
  id                String           @id @default(uuid())
  projectId         String
  project           Project          @relation(fields: [projectId], references: [id])
  departmentId      String?
  department        Department?      @relation(fields: [departmentId], references: [id])
  title             String
  description       String?
  sequence          Int              @default(0)
  status            TaskStatus       @default(PENDING)
  estimatedHours    Float?
  actualHours       Float?
  assignedTeamId    String?
  dependsOnTaskId   String?
  startedAt         DateTime?
  finishedAt        DateTime?
  productionOrders  ProductionOrder[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  @@index([projectId])
  @@index([departmentId])
  @@index([status])
  @@index([deletedAt])
  @@map("project_tasks")
}

model ProductionOrder {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id])
  projectTaskId   String?
  projectTask     ProjectTask? @relation(fields: [projectTaskId], references: [id])
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])
  number          String   @unique
  title           String
  description     String?
  status          String   @default("pending")
  priority        String   @default("normal")
  assignedTeamId  String?
  estimatedHours  Float?
  actualHours     Float?
  startedAt       DateTime?
  finishedAt      DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  @@index([companyId])
  @@index([deletedAt])
  @@index([companyId, deletedAt])
  @@index([projectId])
  @@index([departmentId])
  @@index([status])
  @@map("production_orders")
}

model Template {
  id        String    @id @default(uuid())
  name      String
  content   Json?
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  @@index([companyId])
  @@index([deletedAt])
  @@map("templates")
}

model ServiceCategory {
  id          String    @id @default(uuid())
  name        String
  description String?
  icon        String?
  color       String?
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id])
  subcategories ServiceSubcategory[]
  services     CatalogService[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  @@index([companyId])
  @@index([deletedAt])
  @@index([companyId, deletedAt])
  @@index([active])
  @@map("service_categories")
}

model ServiceSubcategory {
  id          String    @id @default(uuid())
  categoryId  String
  category    ServiceCategory @relation(fields: [categoryId], references: [id])
  name        String
  description String?
  image       String?
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  services    CatalogService[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  @@index([categoryId])
  @@index([companyId])
  @@index([deletedAt])
  @@index([companyId, deletedAt])
  @@index([active])
  @@map("service_subcategories")
}

model CatalogService {
  id                   String          @id @default(uuid())
  categoryId           String
  category             ServiceCategory @relation(fields: [categoryId], references: [id])
  subcategoryId        String?
  subcategory          ServiceSubcategory? @relation(fields: [subcategoryId], references: [id])
  code                 String          @unique
  name                 String
  description          String?
  image                String?
  version              String          @default("1.0.0")
  averageProductionTime Float?
  requiresVisit        Boolean         @default(false)
  requiresApproval     Boolean         @default(false)
  requiresArt          Boolean         @default(false)
  hasPrinting          Boolean         @default(false)
  hasInstallation      Boolean         @default(false)
  hasPainting          Boolean         @default(false)
  hasTransport         Boolean         @default(false)
  defaultMargin        Float           @default(0)
  minimumMargin        Float           @default(0)
  maximumMargin        Float           @default(100)
  commission           Float           @default(0)
  tax                  Float           @default(0)
  markup               Float           @default(0)
  minimumCost          Float           @default(0)
  active               Boolean         @default(true)
  companyId            String
  company              Company         @relation(fields: [companyId], references: [id])
  components           ServiceComponent[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  @@index([categoryId])
  @@index([companyId])
  @@index([deletedAt])
  @@index([companyId, deletedAt])
  @@index([active])
  @@index([name])
  @@map("catalog_services")
}

model ServiceComponent {
  id            String        @id @default(uuid())
  serviceId     String
  service       CatalogService @relation(fields: [serviceId], references: [id])
  name          String
  description   String?
  componentType ComponentType @default(MATERIAL)
  required      Boolean       @default(true)
  sequence      Int           @default(0)
  active        Boolean       @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  @@index([serviceId])
  @@index([deletedAt])
  @@index([active])
  @@map("service_components")
}

model MaterialCategory {
  id          String    @id @default(uuid())
  name        String
  description String?
  color       String?
  icon        String?
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  materials   Material[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  @@index([companyId])
  @@index([deletedAt])
  @@index([companyId, deletedAt])
  @@map("material_categories")
}

model Material {
  id             String         @id @default(uuid())
  categoryId     String
  category       MaterialCategory @relation(fields: [categoryId], references: [id])
  code           String         @unique
  name           String
  description    String?
  brand          String?
  manufacturer   String?
  supplier       String?
  unit           UnitOfMeasure  @default(UN)
  cost           Float          @default(0)
  salePrice      Float          @default(0)
  lossPercent    Float          @default(0)
  minimumStock   Int            @default(0)
  currentStock   Int            @default(0)
  weight         Float?
  width          Float?
  height         Float?
  thickness      Float?
  color          String?
  reference      String?
  barcode        String?
  notes          String?
  active         Boolean        @default(true)
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  @@index([categoryId])
  @@index([companyId])
  @@index([deletedAt])
  @@index([companyId, deletedAt])
  @@index([name])
  @@index([active])
  @@map("materials")
}

model Team {
  id           String    @id @default(uuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id])
  code         String    @unique
  name         String
  description  String?
  hourCost     Float     @default(0)
  dailyCost    Float     @default(0)
  defaultMargin Float    @default(0)
  active       Boolean   @default(true)
  members      TeamMember[]
  productivity TeamProductivity[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  @@index([companyId])
  @@index([deletedAt])
  @@index([companyId, deletedAt])
  @@map("teams")
}

model TeamMember {
  id        String    @id @default(uuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  teamId    String?
  team      Team?     @relation(fields: [teamId], references: [id])
  name      String
  role      TeamRole?
  hourCost  Float     @default(0)
  active    Boolean   @default(true)

  @@index([companyId])
  @@index([teamId])
  @@index([active])
  @@map("team_members")
}

model TeamProductivity {
  id                  String  @id @default(uuid())
  companyId           String
  company             Company @relation(fields: [companyId], references: [id])
  teamId              String
  team                Team    @relation(fields: [teamId], references: [id])
  serviceType         String
  unit                String?
  productionPerHour   Float   @default(0)
  installationPerHour Float   @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([companyId])
  @@index([teamId])
  @@map("team_productivity")
}

model EquipmentCategory {
  id        String    @id @default(uuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  name      String
  description String?
  icon      String?
  color     String?
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  equipments Equipment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  @@index([companyId])
  @@index([deletedAt])
  @@index([companyId, deletedAt])
  @@map("equipment_categories")
}

model Equipment {
  id              String            @id @default(uuid())
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id])
  categoryId      String
  category        EquipmentCategory @relation(fields: [categoryId], references: [id])
  costType        EquipmentCostType @default(HOUR)
  code            String            @unique
  name            String
  description     String?
  brand           String?
  model           String?
  serialNumber    String?
  patrimonyNumber String?
  supplier        String?
  purchaseDate    DateTime?
  purchaseValue   Float     @default(0)
  residualValue   Float     @default(0)
  hourCost        Float     @default(0)
  dailyCost       Float     @default(0)
  kmCost          Float     @default(0)
  monthlyCost     Float     @default(0)
  fuelConsumption Float?
  capacity        Float?
  unit            String?
  notes           String?
  active          Boolean   @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  @@index([companyId])
  @@index([categoryId])
  @@index([deletedAt])
  @@index([companyId, deletedAt])
  @@index([active])
  @@map("equipments")
}

model Quotation {
  id            String          @id @default(uuid())
  companyId     String
  company       Company         @relation(fields: [companyId], references: [id])
  clientId      String?
  number        String          @unique
  version       Int             @default(1)
  status        QuotationStatus @default(DRAFT)
  title         String
  description   String?
  validUntil    DateTime?
  subtotal      Float           @default(0)
  discount      Float           @default(0)
  discountType  DiscountType?
  total         Float           @default(0)
  notes         String?
  internalNotes String?

  items QuotationItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  @@index([companyId])
  @@index([clientId])
  @@index([deletedAt])
  @@index([companyId, deletedAt])
  @@index([status])
  @@index([createdAt])
  @@map("quotations")
}

model QuotationItem {
  id               String   @id @default(uuid())
  quotationId      String
  quotation        Quotation @relation(fields: [quotationId], references: [id])
  serviceId        String?
  description      String
  quantity         Float    @default(1)
  unit             String   @default("UN")
  unitPrice        Float    @default(0)
  totalPrice       Float    @default(0)
  pricingSnapshot  Json?
  sortOrder        Int      @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  @@index([quotationId])
  @@index([deletedAt])
  @@map("quotation_items")
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String
  changes    Json?
  metadata   Json?
  userId     String?
  companyId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?
  createdBy  String?
  updatedBy  String?
  deletedBy  String?

  @@index([companyId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("audit_logs")
}

model ApiKey {
  id          String    @id @default(uuid())
  companyId   String
  name        String
  key         String    @unique
  secret      String
  permissions String[]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?
  deletedBy   String?

  @@index([companyId])
  @@index([key])
  @@index([active])
  @@index([companyId, active])
  @@map("api_keys")
}

model Webhook {
  id         String   @id @default(uuid())
  companyId  String
  name       String
  url        String
  events     String[]
  secret     String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?
  createdBy  String?
  updatedBy  String?
  deletedBy  String?

  @@index([companyId])
  @@index([active])
  @@index([companyId, active])
  @@map("webhooks")
}

model WebhookLog {
  id             String    @id @default(uuid())
  webhookId      String
  event          String
  payload        Json
  responseStatus Int?
  responseBody   String?
  attempts       Int       @default(1)
  executedAt     DateTime  @default(now())

  @@index([webhookId])
  @@index([event])
  @@index([executedAt])
  @@map("webhook_logs")
}

model ApiLog {
  id           String   @id @default(uuid())
  apiKeyId     String
  endpoint     String
  method       String
  statusCode   Int
  responseTime Int
  ip           String?
  createdAt    DateTime @default(now())

  @@index([apiKeyId])
  @@index([endpoint])
  @@index([createdAt])
  @@map("api_logs")
}

enum WorkflowTrigger {
  CLIENT_CREATED
  LEAD_CREATED
  LEAD_CONVERTED
  QUOTE_APPROVED
  PROJECT_CREATED
  WORKORDER_CREATED
  PRODUCTION_FINISHED
  INSTALLATION_FINISHED
  FINANCIAL_RECEIVED
  FINANCIAL_PAID
  USER_CREATED
}

enum WorkflowExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model Workflow {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  description String?
  active      Boolean  @default(true)
  trigger     WorkflowTrigger

  steps      WorkflowStep[]
  executions WorkflowExecution[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  @@index([companyId])
  @@index([deletedAt])
  @@index([companyId, deletedAt])
  @@index([trigger])
  @@index([active])
  @@map("workflows")
}

model WorkflowStep {
  id            String   @id @default(uuid())
  workflowId    String
  workflow      Workflow @relation(fields: [workflowId], references: [id])
  order         Int
  type          String
  configuration Json

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  @@index([workflowId])
  @@index([deletedAt])
  @@map("workflow_steps")
}

model WorkflowExecution {
  id         String                  @id @default(uuid())
  workflowId String
  workflow   Workflow                @relation(fields: [workflowId], references: [id])
  status     WorkflowExecutionStatus @default(PENDING)
  startedAt  DateTime?
  finishedAt DateTime?
  duration   Int?
  error      String?

  logs WorkflowExecutionLog[]

  @@index([workflowId])
  @@index([status])
  @@index([startedAt])
  @@map("workflow_executions")
}

model WorkflowExecutionLog {
  id          String   @id @default(uuid())
  executionId String
  execution   WorkflowExecution @relation(fields: [executionId], references: [id])
  step        String
  status      String
  message     String?
  createdAt   DateTime @default(now())

  @@index([executionId])
  @@map("workflow_execution_logs")
}

model AiProvider {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  provider    String
  model       String
  apiKey      String
