# ═══════════════════════════════════════
# Visual ERP — Variáveis de Ambiente
# ═══════════════════════════════════════

# ─── Ambiente ──────────────────────────
NODE_ENV=development

# ─── Supabase (Autenticação e Banco) ───
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Database (PostgreSQL) ─────────────
# Development: postgresql://postgres:password@localhost:5432/visual-erp-dev
# Staging:     postgresql://postgres:password@host:5432/visual-erp-staging
# Production:  postgresql://postgres:password@host:5432/visual-erp-prod
DATABASE_URL=
DIRECT_URL=

# ─── URL do Site ──────────────────────
# Development: http://localhost:3000
# Staging:     https://staging.visualerp.com.br
# Production:  https://app.visualerp.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_URL=http://localhost:3000

# ─── Prisma ────────────────────────────
PRISMA_CLIENT_ENGINE_TYPE=

# ─── Storage ───────────────────────────
# Supabase Storage bucket for uploads
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=visual-erp-uploads

# ─── Segurança ─────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
